#--- tutte le forme
pulisci()
pulisci(BLU)
punto(10, 20, BIANCO)
linea(0, 0, 239, 134, VERDE)
rettangolo(10, 10, 50, 30, ROSSO)
cornice(10, 10, 50, 30, GIALLO)
cerchio(120, 67, 20, ARANCIO)
anello(120, 67, 25, AZZURRO)
scritta(5, 5, "Punti: " + 3, BIANCO)
scritta(5, 100, 42, VIOLA, 3)
