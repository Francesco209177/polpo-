#--- le misure con la virgola si arrotondano, quelle enormi si limitano
punto(1.4, 1.6, 65535)
cerchio(-5, 1000000, 2.5, 0)
#--- la pallina che rimbalza
x = 230
vx = 4
ripeti 4 volte
  pulisci()
  cerchio(x, 60, 5, ROSSO)
  x = x + vx
  se x > 235 oppure x < 5 allora
    vx = -vx
    suona(880, 30)
  fine
  mostra()
  aspetta(30)
fine
