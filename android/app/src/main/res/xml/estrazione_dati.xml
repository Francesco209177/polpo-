<?xml version="1.0" encoding="utf-8"?>
<!-- I dati dell'app (microSD del Polpo simulato, bozze) restano sul telefono: nessuna copia nel cloud né su altri dispositivi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
